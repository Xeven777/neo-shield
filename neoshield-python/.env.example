# Copy to .env for local development. Never commit real tokens.

# Next.js app origin reachable from this service.
# Local dev: http://localhost:3000 | Compose: http://web:3000
NEOSHIELD_WEB_URL=http://localhost:3000

# Token issued in NeoShield -> Settings -> Worker tokens (shown once).
NEOSHIELD_WORKER_TOKEN=

# Optional first-boot registration instead of a pre-issued token.
# Must match WORKER_BOOTSTRAP_TOKEN in the web app.
NEOSHIELD_BOOTSTRAP_TOKEN=
NEOSHIELD_WORKSPACE_ID=
NEOSHIELD_WORKER_NAME=neoshield-worker

# --- Database ---------------------------------------------------------------
# Use a restricted Neon role, not the migration/owner role. The worker only
# needs: SELECT/UPDATE scan_job, UPDATE worker, and INSERT/UPDATE on scan_run,
# finding, finding_evidence, finding_status_event.
NEOSHIELD_DATABASE_URL=postgresql://worker:password@ep-xxxx-pooler.region.aws.neon.tech/db?sslmode=require

# --- GitHub App -------------------------------------------------------------
# Same App as the web app. The private key may contain escaped newlines.
NEOSHIELD_GITHUB_APP_ID=
NEOSHIELD_GITHUB_APP_PRIVATE_KEY=

# --- Scanners ---------------------------------------------------------------
# Binaries are pinned and downloaded on first startup (checksums verified when
# the project publishes them). Set auto-install false to manage them yourself.
NEOSHIELD_SCANNER_DIR=/opt/neoshield/scanners
NEOSHIELD_SCANNER_AUTO_INSTALL=true

# --- Limits -----------------------------------------------------------------
# Stricter Phase 1 profile: fail the scan if any scanner errors.
NEOSHIELD_MAX_ARCHIVE_BYTES=52428800
NEOSHIELD_MAX_EXTRACTED_FILES=5000
NEOSHIELD_MAX_FILE_BYTES=5242880
NEOSHIELD_MAX_EXTRACTED_BYTES=209715200
NEOSHIELD_TOOL_TIMEOUT_SECONDS=180
NEOSHIELD_STALE_FINDING_ABSENCES=2
NEOSHIELD_JOB_LEASE_SECONDS=600
NEOSHIELD_JOB_POLL_INTERVAL_SECONDS=5

# --- Domain checks ----------------------------------------------------------
# Public DNS/TLS/HTTP checks only. Private, loopback, link-local, reserved and
# shared addresses are always refused, including redirect targets.
NEOSHIELD_DOMAIN_TIMEOUT_SECONDS=15
NEOSHIELD_DOMAIN_MAX_REDIRECTS=5
NEOSHIELD_DOMAIN_CERTIFICATE_WARNING_DAYS=30

# --- Wazuh endpoint monitoring (Phase 2) ----------------------------------
# Credentials stay in this service; the web UI only enables ingestion for a
# project. Keep manager/indexer/dashboard ports on localhost or a private
# network. Never publish 1514, 1515, 55000, 9200 or 443.
NEOSHIELD_WAZUH_ENABLED=false
NEOSHIELD_WAZUH_INDEXER_URL=https://127.0.0.1:9200
NEOSHIELD_WAZUH_INDEXER_USERNAME=
NEOSHIELD_WAZUH_INDEXER_PASSWORD=
# Optional bearer token instead of basic auth.
NEOSHIELD_WAZUH_INDEXER_API_TOKEN=
NEOSHIELD_WAZUH_INDEXER_VERIFY_TLS=true
NEOSHIELD_WAZUH_INDEXER_CA_PATH=
NEOSHIELD_WAZUH_INDEX_PATTERN=wazuh-alerts-*
NEOSHIELD_WAZUH_MIN_LEVEL=5
NEOSHIELD_WAZUH_POLL_INTERVAL_SECONDS=60
NEOSHIELD_WAZUH_INITIAL_LOOKBACK_MINUTES=60
NEOSHIELD_WAZUH_ENDPOINT_LOOKBACK_HOURS=24
NEOSHIELD_WAZUH_MAX_ALERTS_PER_POLL=200
NEOSHIELD_WAZUH_REQUEST_TIMEOUT_SECONDS=20
# Optional manager API for agent inventory. Alerts come from the indexer.
NEOSHIELD_WAZUH_MANAGER_URL=https://127.0.0.1:55000
NEOSHIELD_WAZUH_MANAGER_USERNAME=
NEOSHIELD_WAZUH_MANAGER_PASSWORD=
NEOSHIELD_WAZUH_MANAGER_VERIFY_TLS=true

# --- Authorized network discovery (Phase 2) -------------------------------
# Nmap must be installed (the container image includes it) or set an explicit
# path. Only private RFC1918/CGNAT ranges up to /24 are accepted; there is no
# override for public ranges.
NEOSHIELD_NMAP_PATH=
NEOSHIELD_NETWORK_MAX_PREFIX_LENGTH=24
NEOSHIELD_NETWORK_MAX_HOSTS=256
NEOSHIELD_NETWORK_SCAN_TIMEOUT_SECONDS=480
NEOSHIELD_NETWORK_HOST_TIMEOUT_SECONDS=60
NEOSHIELD_NETWORK_MAX_OUTPUT_BYTES=8388608
NEOSHIELD_NETWORK_MAX_SERVICE_HOSTS=64
NEOSHIELD_NETWORK_PORTS=21,22,23,25,53,80,110,143,443,445,993,995,1433,1521,2049,2375,3306,3389,5432,5900,6379,8080,8443,9200,11211,27017
NEOSHIELD_NETWORK_ALLOW_PUBLIC=false

# Operational tuning.
NEOSHIELD_HEARTBEAT_INTERVAL_SECONDS=30
NEOSHIELD_REQUEST_TIMEOUT_SECONDS=10
NEOSHIELD_LOG_LEVEL=INFO
