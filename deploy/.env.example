# ---------------------------------------------------------------------------
# NeoShield deploy .env — feeds both web and worker containers.
# Never commit the real file.
# ---------------------------------------------------------------------------

# --- Choose your DB mode ---
# Set either NEON_DATABASE_URL or LOCAL_POSTGRES=1 to pick the mode.
# If neither is set, the compose file falls back to Neon (no pg service).
NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
LOCAL_POSTGRES=0          # set to 1 to use the local postgres service (compose --profile local-db)

# --- Web (Better Auth + Next.js) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://your-domain.example
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM="NeoShield <noreply@your-domain.example>"

# --- GitHub App (same values for web and worker) ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM encoded, single line with \n escapes is accepted.
GITHUB_APP_PRIVATE_KEY=
# The Python worker reads the same App under the NEOSHIELD_ prefix.
NEOSHIELD_GITHUB_APP_ID=
NEOSHIELD_GITHUB_APP_PRIVATE_KEY=
# GitHub App OAuth credentials for Better Auth sign-in (callback:
# ${BETTER_AUTH_URL}/api/auth/callback/github). Separate from installation
# permissions used for repository scanning.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# --- Worker ---
NEOSHIELD_WORKER_TOKEN=
NEOSHIELD_WORKER_NAME=neoshield-worker
NEOSHIELD_HEARTBEAT_INTERVAL_SECONDS=30
NEOSHIELD_LOG_LEVEL=INFO

# --- Database URLs (override as needed) ---
# Neon mode (default when LOCAL_POSTGRES != 1):
#   The web app and worker each use their own restricted URL; compose injects
#   these at runtime from the env_file (.env). Keep them pointing at your Neon
#   project; the worker role needs SELECT/UPDATE on scan_job, UPDATE on worker,
#   INSERT/UPDATE on scan_run/finding/finding_evidence/finding_status_event.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
NEOSHIELD_DATABASE_URL=postgresql://worker:password@ep-xxxx-pooler.REGION.aws.neon.tech/db?sslmode=require

# Local PostgreSQL mode (use when LOCAL_POSTGRES=1 and docker compose --profile local-db up):
#   These default to the postgres service defined in compose.yaml; override if
#   you use different user/password/db names.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=neoshield
# Derived URLs (usually don't need to set these manually):
#   DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
#   NEOSHIELD_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# --- Scanner limits (same as neoshield-python/.env.example) ---
NEOSHIELD_SCANNER_DIR=/opt/neoshield/scanners
NEOSHIELD_SCANNER_AUTO_INSTALL=true
NEOSHIELD_MAX_ARCHIVE_BYTES=52428800
NEOSHIELD_MAX_EXTRACTED_FILES=5000
NEOSHIELD_TOOL_TIMEOUT_SECONDS=180

# --- Phase 2: endpoint + network (worker only) ------------------------------
# Wazuh credentials never reach the web container or browser. Keep the Wazuh
# lab ports bound to localhost/private addresses; nothing here should be a
# public hostname except through an authenticated tunnel.
NEOSHIELD_WAZUH_ENABLED=false
NEOSHIELD_WAZUH_INDEXER_URL=https://127.0.0.1:9200
NEOSHIELD_WAZUH_INDEXER_USERNAME=
NEOSHIELD_WAZUH_INDEXER_PASSWORD=
NEOSHIELD_WAZUH_INDEXER_VERIFY_TLS=true
NEOSHIELD_WAZUH_MANAGER_URL=https://127.0.0.1:55000
NEOSHIELD_WAZUH_MANAGER_USERNAME=
NEOSHIELD_WAZUH_MANAGER_PASSWORD=
NEOSHIELD_WAZUH_MANAGER_VERIFY_TLS=true

# Nmap is installed in the worker image. Only private RFC1918/CGNAT CIDRs up to
# /24 can be queued from the UI, each with an exact typed confirmation.
NEOSHIELD_NMAP_PATH=
NEOSHIELD_NETWORK_MAX_PREFIX_LENGTH=24
NEOSHIELD_NETWORK_MAX_HOSTS=256
NEOSHIELD_NETWORK_MAX_SERVICE_HOSTS=64
NEOSHIELD_NETWORK_PORTS=21,22,23,25,53,80,110,143,443,445,993,995,1433,1521,2049,2375,3306,3389,5432,5900,6379,8080,8443,9200,11211,27017
NEOSHIELD_NETWORK_ALLOW_PUBLIC=false
