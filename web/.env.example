# Neon PostgreSQL. Use the pooled connection string for the web app:
# postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of this app. Must match the browser URL.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (Resend — https://resend.com). Used for OTP and magic
# links. Without a key, codes/links are printed to the server log in development.
RESEND_API_KEY=
EMAIL_FROM="NeoShield <noreply@example.com>"

# Bootstrap credential for the Python worker's first registration.
# Generate with: openssl rand -hex 32. Only needed for the register endpoint.
WORKER_BOOTSTRAP_TOKEN=

# GitHub App. Create at https://github.com/settings/apps with read-only
# contents/metadata and the callback + setup URLs below.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
# GitHub App OAuth credentials for Better Auth sign-in
# (callback: ${BETTER_AUTH_URL}/api/auth/callback/github). Separate from
# repository/install permissions granted by the App installation.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Set to 1 to also log OTPs/magic links to the server console in production.
# Leave empty in production so codes never appear in logs.
AUTH_EMAIL_LOG_CODES=

# Wazuh and Nmap settings are worker-only: the web app never talks to the
# indexer, manager or scanner. Do not add Wazuh credentials here. See
# neoshield-python/.env.example for NEOSHIELD_WAZUH_* and NEOSHIELD_NETWORK_*.

